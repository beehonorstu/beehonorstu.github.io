---
import { languages, defaultLang } from '~/i18n/ui';
import { useTranslations } from '~/i18n/utils';
import { getChargeExpertName } from '~/i18n/productNames';
import { getCollection } from 'astro:content';
import Layout from '~/layouts/Layout.astro';
import Hero from '~/components/sections/Hero.astro';
import Section from '~/components/layout/Section.astro';
import BentoGrid from '~/components/sections/BentoGrid.astro';
import BentoItem from '~/components/ui/BentoItem.astro';
import { Gamepad2, Wrench, Globe } from 'lucide-react';
import { getRelativeLocaleUrl } from 'astro:i18n';

export async function getStaticPaths() {
  return Object.keys(languages)
    .filter((lang) => lang !== defaultLang)
    .map((lang) => ({ params: { lang } }));
}

const { lang = defaultLang } = Astro.params;
const t = useTranslations(lang);
const chargeExpertName = getChargeExpertName(lang);
const localizedProducts = await getCollection('products', ({ id }) => id.startsWith(`${lang}/`));
const localizedDescription = (slug: string, fallback: string) =>
  localizedProducts.find(({ id }) => id.endsWith(`/${slug}.md`))?.data.description || fallback;

---

<Layout title={`BeHonor Studio | ${t['nav.products']}`} description={t['about.mission']}>
    <Hero 
        badge={t['hero.badge']}
        title={t['hero.title']}
        highlight="BeHonor Studio"
        description={t['about.mission']}
        primaryCta={{ text: t['home.store.cta'], href: "https://play.google.com/store/apps/developer?id=BeHonor+Studio" }}
    />
    
    <Section 
        class="py-0 overflow-visible mb-24"
        id="apps" 
    >
        <BentoGrid title={t['home.featured.title']}>
            <!-- Lead product: ISS Tracker -->
            <BentoItem class="md:col-span-2 md:row-span-2 group cursor-pointer" data-product-id="isstracker" data-analytics-action="select_product" data-analytics-location="home_featured" as="a" href={getRelativeLocaleUrl(lang, '/products/isstracker')}>
                <div class="absolute inset-0 bg-[#080e18]"></div>
                <img src="/images/apps/isstracker_banner.webp" alt="ISS Tracker orbital tracking" class="absolute inset-0 w-full h-full object-cover opacity-90 transition-transform duration-700 group-hover:scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>

                <div class="relative z-20 h-full flex flex-col justify-end">
                    <div class="flex items-center gap-4 mb-4">
                        <img src="/images/apps/isstracker_icon.webp" alt="ISS Tracker Icon" class="w-16 h-16 rounded-xl shadow-lg border border-white/10" />
                        <h3 class="text-3xl md:text-4xl font-bold text-white">ISS Tracker</h3>
                    </div>
                    <p class="text-white/85 text-lg max-w-xl">{localizedDescription('isstracker', 'Follow the International Space Station in real time, predict overhead passes, and watch live views from orbit.')}</p>
                </div>
            </BentoItem>

            <!-- Right, top: Beat Expert -->
            <BentoItem class="group cursor-pointer min-h-[300px]" data-product-id="drumpads" data-analytics-action="select_product" data-analytics-location="home_featured" as="a" href={getRelativeLocaleUrl(lang, '/products/drumpads')}>
                <div class="absolute inset-0 bg-gradient-to-br from-[#13203a] via-[#111426] to-[#090d18]"></div>
                <div class="absolute -top-12 -right-12 h-52 w-52 rounded-full bg-fuchsia-500/20 blur-3xl"></div>
                <img src="/images/apps/beat_expert_icon.png" alt="Beat Expert drum pads" class="absolute right-2 top-1 h-[78%] w-auto max-w-[90%] object-contain opacity-85 transition-transform duration-700 group-hover:scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/35 to-transparent"></div>

                <div class="relative z-20 h-full flex flex-col justify-end">
                    <div class="flex items-center gap-3 mb-2">
                        <img src="/images/apps/beat_expert_icon.png" alt="Beat Expert Icon" class="w-12 h-12 rounded-xl shadow-lg" />
                        <h3 class="text-xl font-bold text-white">Beat Expert</h3>
                    </div>
                    <p class="text-white/85 text-sm">{t['home.beat.description']}</p>
                </div>
            </BentoItem>

            <!-- Right, bottom: Charge Expert -->
            <BentoItem class="group cursor-pointer min-h-[300px]" data-product-id="phonebattery" data-analytics-action="select_product" data-analytics-location="home_featured" as="a" href={getRelativeLocaleUrl(lang, '/products/phonebattery')}>
                <div class="absolute inset-0 bg-[#0d1916]"></div>
                <img src="https://cdn.sanity.io/images/9urti28l/production/f6baa6337fdad0626d0efd7cd4d7003c63e798c8-1748x900.png" alt={`${chargeExpertName} charging monitor`} loading="lazy" class="absolute inset-0 w-full h-full object-cover opacity-80 transition-transform duration-700 group-hover:scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>

                <div class="relative z-20 h-full flex flex-col justify-end">
                    <div class="flex items-center gap-3 mb-2">
                        <img src="/images/apps/charge_expert_icon.svg" alt={`${chargeExpertName} Icon`} class="w-12 h-12 rounded-xl shadow-lg" />
                        <h3 class="text-xl font-bold text-white">{chargeExpertName}</h3>
                    </div>
                    <p class="text-white/85 text-sm">{localizedDescription('phonebattery', 'Plan charging, track live battery power and temperature, and get timely reminders.')}</p>
                </div>
            </BentoItem>

            <!-- Second row: Math Puzzle -->
            <BentoItem class="md:col-span-2 group cursor-pointer min-h-[300px]" data-product-id="mathpuzzle" data-analytics-action="select_product" data-analytics-location="home_featured" as="a" href={getRelativeLocaleUrl(lang, '/products/mathpuzzle')}>
                <div class="absolute inset-0 bg-[#0f1621]"></div>
                <img src="/images/apps/mathpuzzle_banner.webp" alt="Math Puzzle" loading="lazy" class="absolute inset-0 w-full h-full object-cover opacity-75 transition-transform duration-700 group-hover:scale-105" style="object-position: center 28%;" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent"></div>

                <div class="relative z-20 h-full flex flex-col justify-end">
                    <div class="flex items-center gap-3 mb-2">
                        <img src="/images/apps/mathpuzzle_icon.webp" alt="Math Puzzle Icon" class="w-12 h-12 rounded-xl shadow-lg border border-white/10" />
                        <h3 class="text-2xl font-bold text-white">Math Puzzle</h3>
                    </div>
                    <p class="text-white/85 text-sm max-w-lg">{localizedDescription('mathpuzzle', 'Solve cross-number equation puzzles with a relaxing mix of arithmetic, logic, and observation.')}</p>
                </div>
            </BentoItem>

            <!-- Closing cell keeps the featured-app grid balanced across screens -->
            <BentoItem class="group min-h-[300px] flex flex-col justify-end">
                <div class="absolute inset-0 bg-gradient-to-br from-primary/10 via-transparent to-primary/5"></div>
                <div class="relative z-10">
                    <div class="mb-4 w-11 h-11 flex items-center justify-center rounded-2xl bg-primary/10">
                        <Globe className="w-6 h-6 text-primary" />
                    </div>
                    <h3 class="text-2xl font-display font-bold mb-2">{t['nav.all.products']}</h3>
                    <p class="text-muted-foreground text-sm mb-5">{t['portfolio.hero.subtitle']}</p>
                    <a href={getRelativeLocaleUrl(lang, '/products')} class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline">{t['nav.all.products']} <span aria-hidden="true">→</span></a>
                </div>
            </BentoItem>

        </BentoGrid>
    </Section>
</Layout>
