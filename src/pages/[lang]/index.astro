---
import { languages, defaultLang } from '~/i18n/ui';
import { useTranslations } from '~/i18n/utils';
import { getChargeExpertName } from '~/i18n/productNames';
import Layout from '~/layouts/Layout.astro';
import Schema from '~/components/layout/Schema.astro';
import Hero from '~/components/sections/Hero.astro';
import Section from '~/components/layout/Section.astro';
import BentoGrid from '~/components/sections/BentoGrid.astro';
import BentoItem from '~/components/ui/BentoItem.astro';
import { Gamepad2, Wrench, Globe } from 'lucide-react';
import { getRelativeLocaleUrl } from 'astro:i18n';

export async function getStaticPaths() {
  return Object.keys(languages)
    .filter((lang) => lang !== defaultLang)
    .map((lang) => ({ params: { lang } }));
}

const { lang = defaultLang } = Astro.params;
const t = useTranslations(lang);
const chargeExpertName = getChargeExpertName(lang);

---

<Layout title="BeHonor Studio | Apps & Games" description={`BeHonor Studio - Creator of ${chargeExpertName}, Math Puzzle, Flick Wand, and ISS Tracker.`}>
    <Schema item={{
            "@context": "https://schema.org",
            "@type": "Organization",
            "name": "BeHonor Studio",
            "url": Astro.site,
            "logo": "https://play-lh.googleusercontent.com/MRSqPcyaLlYxqN45WQKg_ySHOeXimarn4vt3CyGJ2s5TL39PutxRPn_ypA4daars8DE=w512"
        }} />
	
    <Hero 
        title="Welcome to"
        highlight="BeHonor Studio"
        description="Building high-quality applications that bring fun, focus, and discovery to your everyday life."
        primaryCta={{ text: "View Our Apps on Google Play", href: "https://play.google.com/store/apps/developer?id=BeHonor+Studio" }}
    />
    
    <Section 
        class="py-0 overflow-visible mb-24"
        id="apps" 
    >
        <BentoGrid title="Featured Apps">
            <!-- Large Item: Math Puzzle -->
            <BentoItem class="md:col-span-2 md:row-span-2 group cursor-pointer" onclick={`window.location.href='${getRelativeLocaleUrl(lang, '/products/mathpuzzle')}'`}>
                <div class="absolute bottom-0 left-0 w-full h-2/3 bg-gradient-to-t from-black/80 to-transparent z-10 transition-opacity"></div>
                <img src="/images/apps/mathpuzzle_banner.webp" alt="Math Puzzle" class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-700" style="object-position: center 28%;" />
                
                <div class="relative z-20 h-full flex flex-col justify-end">
                    <div class="flex items-center gap-4 mb-4">
                        <img src="/images/apps/mathpuzzle_icon.webp" alt="Math Puzzle Icon" class="w-16 h-16 rounded-xl shadow-lg border border-white/10" />
                        <h3 class="text-3xl font-bold text-white">Math Puzzle</h3>
                    </div>
                    <p class="text-white/80 text-lg max-w-xl">Solve cross-number equation puzzles with a relaxing mix of arithmetic, logic, and observation.</p>
                </div>
            </BentoItem>

            <!-- Medium Item: ISS Tracker -->
            <BentoItem class="group cursor-pointer min-h-[300px]" onclick={`window.location.href='${getRelativeLocaleUrl(lang, '/products/isstracker')}'`}>
                <div class="absolute bottom-0 left-0 w-full h-2/3 bg-gradient-to-t from-black/80 to-transparent z-10"></div>
                <img src="/images/apps/isstracker_banner.webp" alt="ISS Tracker" class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-700" />
                
                <div class="relative z-20 h-full flex flex-col justify-end">
                    <div class="flex items-center gap-3 mb-2">
                        <img src="/images/apps/isstracker_icon.webp" alt="ISS Tracker Icon" class="w-12 h-12 rounded-xl shadow-lg" />
                        <h3 class="text-xl font-bold text-white">ISS Tracker</h3>
                    </div>
                    <p class="text-white/80 text-sm">Track the International Space Station in real-time. Know exactly when it passes overhead.</p>
                </div>
            </BentoItem>

            <!-- Medium Item: Flick Wand -->
            <BentoItem class="group cursor-pointer min-h-[300px]" onclick={`window.location.href='${getRelativeLocaleUrl(lang, '/products/flickwand')}'`}>
                <div class="absolute bottom-0 left-0 w-full h-2/3 bg-gradient-to-t from-black/80 to-transparent z-10"></div>
                <img src="/images/apps/flickwand_banner.webp" alt="Flick Wand" class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-700" />
                
                <div class="relative z-20 h-full flex flex-col justify-end">
                    <div class="flex items-center gap-3 mb-2">
                        <img src="/images/apps/flickwand_icon.webp" alt="Flick Wand Icon" class="w-12 h-12 rounded-xl shadow-lg" />
                        <h3 class="text-xl font-bold text-white">Flick Wand</h3>
                    </div>
                    <p class="text-white/80 text-sm">Automate and launch actions instantly with intuitive gestures. Your daily tasks made highly efficient.</p>
                </div>
            </BentoItem>

            <!-- Wide Item: Charge Expert charging monitor -->
            <BentoItem class="md:col-span-2 group cursor-pointer min-h-[300px]" onclick={`window.location.href='${getRelativeLocaleUrl(lang, '/products/phonebattery')}'`}>
                <div class="absolute inset-0 bg-[#0d1916]"></div>
                <img src="https://cdn.sanity.io/images/9urti28l/production/f6baa6337fdad0626d0efd7cd4d7003c63e798c8-1748x900.png" alt={`${chargeExpertName} charging monitor`} loading="lazy" class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:scale-[1.035] transition-transform duration-700" />
                <div class="absolute bottom-0 left-0 w-full h-3/4 bg-gradient-to-t from-black/85 via-black/50 to-transparent z-10"></div>

                <div class="relative z-20 h-full flex flex-col justify-end">
                    <div class="flex items-center gap-3 mb-2">
                        <img src="/images/apps/phonebattery_icon.svg" alt={`${chargeExpertName} Icon`} class="w-12 h-12 rounded-xl shadow-lg" />
                        <h3 class="text-2xl font-bold text-white">{chargeExpertName}</h3>
                    </div>
                    <p class="text-white/80 text-sm max-w-lg">Plan charging, track live battery power and temperature, and get timely reminders.</p>
                </div>
            </BentoItem>

            <!-- Closing cell keeps the featured-app grid balanced across screens -->
            <BentoItem class="group min-h-[300px] flex flex-col justify-end">
                <div class="absolute inset-0 bg-gradient-to-br from-primary/10 via-transparent to-primary/5"></div>
                <div class="relative z-10">
                    <div class="mb-4 w-11 h-11 flex items-center justify-center rounded-2xl bg-primary/10">
                        <Globe className="w-6 h-6 text-primary" />
                    </div>
                    <h3 class="text-2xl font-display font-bold mb-2">Explore more apps</h3>
                    <p class="text-muted-foreground text-sm mb-5">Discover our full collection of useful Android apps and playful experiences.</p>
                    <a href={getRelativeLocaleUrl(lang, '/products')} class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline">See all products <span aria-hidden="true">→</span></a>
                </div>
            </BentoItem>

        </BentoGrid>
    </Section>
</Layout>
