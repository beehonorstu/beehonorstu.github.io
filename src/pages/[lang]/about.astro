---
import Layout from '~/layouts/Layout.astro';
import ContentSection from '~/components/sections/ContentSection.astro';
import PageHeader from '~/components/layout/PageHeader.astro';
import { languages, defaultLang } from '~/i18n/ui';
import { useTranslations } from '~/i18n/utils';
import Text from '~/components/ui/Text.astro';

export async function getStaticPaths() {
  return Object.keys(languages)
    .filter((lang) => lang !== defaultLang)
    .map((lang) => ({ params: { lang } }));
}

const { lang = defaultLang } = Astro.params;
const t = useTranslations(lang);
---

<Layout title="About BeHonor Studio" description={t['about.mission']}>
<PageHeader title={t['about.title']} description={t['about.mission']} />

  <ContentSection
    title={t['about.story.title']}
    image="/images/apps/isstracker_banner.webp"
    imageAlt="ISS Tracker — International Space Station tracking app"
  >
    <Text>{t['about.story.p1']}</Text>
    <Text>{t['about.story.p2']}</Text>
    <Text>{t['about.story.p3']}</Text>
  </ContentSection>
  
  <div class="mb-24"></div>
</Layout>
