---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '~/layouts/Layout.astro';
import AppSchema from '~/components/layout/AppSchema.astro';
import { appCatalog, archivedAppSlugs, englishSeoTitles } from '~/lib/appCatalog';
import ISSAppScreenshots from '~/components/ISSAppScreenshots.astro';
import { ArrowLeft, Calendar } from 'lucide-react';
import { defaultLang } from '~/i18n/ui';
import { isRtl, useTranslations } from '~/i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

export async function getStaticPaths() {
	const posts = await getCollection('products');
	return posts
    .filter((post) => post.id.split('/')[0] !== defaultLang)
    .map((post) => {
        const lang = post.id.split('/')[0];
        const slug = post.id.split('/').slice(1).join('/').replace(/\.[^/.]+$/, "");
        return {
		    params: { lang, slug },
		    props: { post },
	    };
    });
}
interface Props {
  post: CollectionEntry<'products'>;
}

const { post } = Astro.props;
const { lang = defaultLang } = Astro.params;
const t = useTranslations(lang);

const { Content } = await render(post);

// Calculate available translations
const allPosts = await getCollection('products');
const currentBaseSlug = post.id.split('/').slice(1).join('/');
const productSlug = currentBaseSlug.replace(/\.(md|mdx)$/, '');
const isIssTracker = productSlug === 'isstracker';
const isBeatExpert = productSlug === 'drumpads';
const isArchived = archivedAppSlugs.has(productSlug);
const productMeta = appCatalog[productSlug];
const storeUrl = isArchived ? undefined : (post.data.link || productMeta?.storeUrl);
const seoTitle = `${lang === defaultLang ? (englishSeoTitles[productSlug] || post.data.title) : post.data.title} | BeHonor Studio`;
const availableLangs = allPosts
    .filter(p => p.id.endsWith(currentBaseSlug))
    .map(p => p.id.split('/')[0]);

---

<Layout 
  title={seoTitle}
  breadcrumbLabel={post.data.title}
  description={post.data.description}
  image={post.data.heroImage}
  noindex={post.data.noindex || isArchived}
  nofollow={post.data.nofollow}
  availableLangs={availableLangs}
>
    {!isArchived && productMeta && !post.data.noindex && (
      <AppSchema slot="head" slug={productSlug} name={post.data.title} description={post.data.description} image={post.data.appIcon || post.data.heroImage} />
    )}
	<article class="pt-32 pb-16">
        <div class="max-w-4xl mx-auto px-6">
            <div class="mb-8">
                 <a 
                    href={getRelativeLocaleUrl(lang, '/products')}
                    class="inline-flex items-center text-sm font-medium text-primary hover:text-primary/80 transition-colors group"
                  >
                    <ArrowLeft className={`w-4 h-4 ${isRtl(lang) ? 'ml-2 rotate-180' : 'mr-2'} group-hover:-translate-x-1 transition-transform`} />
                    {t['portfolio.back']}
                </a>
                
                <div class="flex flex-wrap gap-2 mb-6">
                    {post.data.tags.map(tag => (
                        <span class="text-xs font-medium px-3 py-1 rounded-full bg-foreground/5 text-foreground border border-foreground/10">
                            {tag}
                        </span>
                    ))}
                </div>

                <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:justify-between mb-6">
                    <div class="flex items-center gap-4 min-w-0">
                        {post.data.appIcon && (
                            <img src={post.data.appIcon} alt={`${post.data.title} app icon`} width="64" height="64" class="w-12 h-12 md:w-16 md:h-16 rounded-2xl shadow-lg shrink-0 object-cover" />
                        )}
                        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold break-words">{post.data.title}</h1>
                    </div>
                    {storeUrl && (
                        <a 
                            href={storeUrl}
                            data-product-id={productSlug}
                            data-analytics-location="product_header"
                            target="_blank" 
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 bg-[#01875F] hover:bg-[#01704D] text-white px-4 py-2 rounded-full font-medium transition-colors text-sm shrink-0"
                            title="Get it on Google Play"
                        >
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M19.3 11.2L5.8 3.5C5.1 3 4.2 3.5 4.2 4.3v15.3c0 .9.9 1.4 1.6.9l13.5-7.7c.6-.4.6-1.2 0-1.6z"/>
                            </svg>
                            Google Play
                        </a>
                    )}
                </div>
                <p class="text-xl text-muted-foreground mb-5 dark:text-neutral-300">{post.data.description}</p>
                
                <div class="flex items-center gap-6 text-sm text-muted-foreground border-y border-black/10 dark:border-white/10 py-6 mb-12">
                    <div class="flex items-center gap-2 text-muted-foreground">
                        <Calendar className="w-4 h-4" />
                        <time datetime={post.data.pubDate.toISOString()} class="text-sm">
                            {post.data.pubDate.toLocaleDateString(lang, {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric',
                            })}
                        </time>
                    </div>
                </div>
            </div>
            
            {isIssTracker ? (
                <ISSAppScreenshots />
            ) : isBeatExpert ? (
                <div class="aspect-[16/9] rounded-3xl overflow-hidden border border-white/10 mb-16 shadow-2xl bg-[#0c1220] flex items-center justify-center">
                    <img src={post.data.appIcon} width="512" height="512" alt="Beat Expert official app icon" class="h-[82%] w-auto max-w-[85%] object-contain" />
                </div>
            ) : (
                <div class="rounded-3xl overflow-hidden border border-black/10 dark:border-white/10 mb-16 shadow-2xl bg-black/5 dark:bg-white/5">
                    <img width={1020} height={510} src={post.data.heroImage} alt="" class="w-full h-auto" />
                </div>
            )}

            <div class="prose dark:prose-invert prose-lg max-w-none prose-headings:font-display prose-headings:font-bold prose-headings:text-foreground prose-a:text-primary hover:prose-a:text-primary/80 prose-img:rounded-xl">
 			    <Content />
            </div>
        </div>
	</article>
</Layout>
