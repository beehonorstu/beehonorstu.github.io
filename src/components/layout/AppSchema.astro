---
import Schema from '~/components/layout/Schema.astro';
import { appCatalog } from '~/lib/appCatalog';
import { canonicalFor } from '~/lib/seo';

interface Props {
  slug: string;
  name: string;
  description: string;
  image: string;
}

const { slug, name, description, image } = Astro.props;
const app = appCatalog[slug];
const pageUrl = canonicalFor(Astro.url.pathname, Astro.site!);
const siteRoot = new URL('/', Astro.site!).toString();
---

{app && (
  <Schema item={{
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': pageUrl + '#app',
    name,
    description,
    url: pageUrl,
    operatingSystem: 'Android',
    applicationCategory: app.category,
    image: new URL(image, Astro.site!).toString(),
    downloadUrl: app.storeUrl,
    publisher: { '@id': siteRoot + '#organization' },
    mainEntityOfPage: { '@id': pageUrl + '#webpage' }
  }} />
)}
