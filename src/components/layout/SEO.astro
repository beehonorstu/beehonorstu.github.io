---
import { siteConfig } from '~/site.config';
import { languages, defaultLang } from '~/i18n/ui';
import { canonicalFor, languageTag, localizedUrl, pathWithoutLocale } from '~/lib/seo';

interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  noindex?: boolean;
  nofollow?: boolean;
  availableLangs?: string[];
}

const {
  title,
  description,
  image,
  article = false,
  noindex = false,
  nofollow = false,
  availableLangs
} = Astro.props;

const currentLocale = Astro.params.lang || defaultLang;
const canonicalURL = canonicalFor(Astro.url.pathname, Astro.site!);
const basePath = pathWithoutLocale(Astro.url.pathname, currentLocale);
const ogImageUrl = new URL(image || siteConfig.ogImage, Astro.site).toString();

// Only these routes have a translation in every supported locale.
// Product details explicitly pass their actual available locale list.
// Legal pages and product privacy policies are intentionally single-language.
const fullyTranslatedPaths = new Set(['/', '/about/', '/contact/', '/products/']);
const offeredLocales = availableLangs ??
  (fullyTranslatedPaths.has(basePath) ? Object.keys(languages) : []);
const uniqueLocales = Array.from(new Set(offeredLocales))
  .filter((locale) => locale in languages);
const alternates = !noindex && uniqueLocales.length > 1
  ? uniqueLocales.map((locale) => ({
      hreflang: languageTag(locale),
      href: localizedUrl(basePath, locale, Astro.site!)
    }))
  : [];

const robots = [
  noindex ? 'noindex' : 'index',
  nofollow ? 'nofollow' : 'follow'
].join(', ');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalURL} />
{alternates.map(({ hreflang, href }) => (
  <link rel="alternate" hreflang={hreflang} href={href} />
))}
{alternates.length > 0 && (
  <link rel="alternate" hreflang="x-default" href={localizedUrl(basePath, defaultLang, Astro.site!)} />
)}

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
