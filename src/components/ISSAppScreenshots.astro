---
const screenshots = [
  { file: "isstracker_screenshot_1.svg", alt: "ISS Tracker real-time orbit map and Earth live stream" },
  { file: "isstracker_screenshot_3.svg", alt: "ISS Tracker 3D Earth with live satellite position" },
  { file: "isstracker_screenshot_4.svg", alt: "ISS Tracker Explore with NASA Earth imagery" },
  { file: "isstracker_screenshot_5.svg", alt: "ISS Tracker upcoming rocket launches and countdowns" },
  { file: "isstracker_screenshot_6.svg", alt: "ISS Tracker Discover the ISS science section" },
  { file: "isstracker_screenshot_2.svg", alt: "ISS Tracker orbit map and ISS camera video feed" },
];
---

<section class="mb-16" aria-label="ISS Tracker Android app screenshots">
  <div class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-5" style="scrollbar-width: thin;">
    {screenshots.map((shot, index) => (
      <figure class="shrink-0 snap-start w-[205px] sm:w-[230px] md:w-[246px] rounded-2xl overflow-hidden border border-foreground/10 bg-[#080e18] shadow-xl">
        <img
          src={`/images/apps/${shot.file}`}
          alt={shot.alt}
          width="480"
          height="1040"
          class="w-full h-auto block"
          loading={index < 2 ? "eager" : "lazy"}
          decoding="async"
        />
      </figure>
    ))}
  </div>
</section>
